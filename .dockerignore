# GB10-host build litter from a prior in-tree (non-out-of-tree) cmake config —
# not source, safe to exclude from the Docker build context (regenerated by
# the container's own `vllm.sh build`).
#
# NOTE: /.git is intentionally NOT excluded -- setup.py's get_vllm_version()
# calls setuptools_scm, which needs real git history/tags to derive a version
# ("LookupError: setuptools-scm was unable to detect version"); a git
# checkout without .git doesn't work per setuptools-scm's own error message.
/_deps
# CMake FETCHCONTENT_BASE_DIR (cutlass, etc.) -- its CMakeCache.txt hardcodes
# the host's absolute source path, so copying it in makes CMake refuse to
# configure ("current CMakeCache.txt directory ... is different than the
# directory ... where CMakeCache.txt was created"). Already gitignored
# (.gitignore:/.deps/) but .dockerignore needs its own separate exclusion.
/.deps
/ctest
/CPackConfig.cmake
/CPackSourceConfig.cmake
/cmake_install.cmake
/Makefile
/detect_cuda_version.cc
/csrc/moe/marlin_moe_wna16
/csrc/quantization/marlin
/error.txt
/*.md
/run_experiment.sh
/test_*.py

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

.mypy_cache

